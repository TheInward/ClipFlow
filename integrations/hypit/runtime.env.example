# Server-only configuration. Keep actual secrets in Hypit's credential store.
HYPIT_BIN=/opt/clipflow/hypit-runtime/bin/hypit
HYPIT_RUNTIME_PROFILE=/opt/clipflow/hypit-private/hypit.runtime.json
HYPIT_VIDEO_ADAPTER=/opt/clipflow/hypit-private/model-adapter.mjs
# Do not reuse AUTODL_API_TOKEN as a Hypit credential automatically.

# Enable only after check/plan/doctor confirm the intended Model/Provider and credentials.
HYPIT_RECREATION_ENABLED=false
